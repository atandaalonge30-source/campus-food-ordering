# Example env file for local development / deployment
# Use either DATABASE_URL or the individual DB_* keys

# Full connection URL (preferred for deployments):
# DATABASE_URL=mysql://user:pass@host:3306/campus_food_ordering

# Or individual settings:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_food_ordering

# If your provider requires SSL set to true
DB_SSL=false

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
# =========================================================
# Campus Food Ordering System — Environment Variables
# Copy the relevant section into server/.env and client/.env
# Never commit real secrets to version control.
# =========================================================

# ---------------- SERVER (server/.env) ----------------
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_food_ordering
DB_SSL=false
# Hosted providers may supply one complete connection string instead:
# DATABASE_URL=mysql://user:password@host:3306/database
# MYSQL_URL=mysql://user:password@host:3306/database

JWT_SECRET=replace-this-with-a-long-random-string

CLIENT_URL=http://localhost:5173

PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional — used only by server/utils/seed.js
ADMIN_EMAIL=admin@tpi.edu.ng
ADMIN_PASSWORD=Password123!
ADMIN_NAME=System Administrator

# ---------------- CLIENT (client/.env) ----------------
VITE_API_URL=http://localhost:5000/api
VITE_PAYSTACK_ENABLED=false
